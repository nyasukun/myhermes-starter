{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyasukun/myhermes-starter/schemas/monitoring-batches-page.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person_id",
    "installation_id",
    "manifest_version",
    "source",
    "trust",
    "records",
    "next_before"
  ],
  "properties": {
    "person_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "installation_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_version": {
      "const": "1.0.0"
    },
    "source": {
      "const": "batches"
    },
    "trust": {
      "const": "client_reported_signed"
    },
    "records": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cursor",
          "batch_id",
          "stream_id",
          "batch_sha256",
          "batch",
          "signature",
          "received_at"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "stream_id": {
            "type": "string",
            "format": "uuid"
          },
          "batch_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "batch": {
            "$ref": "audit-batch.v1.schema.json"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          },
          "received_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "next_before": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$comment": "The complete serialized UTF-8 JSON response is bounded to 1048576 bytes, which JSON Schema cannot express. Records are complete accepted batches in descending cursor order. next_before is the last returned cursor only when another record was omitted; use it as an exclusive before bound. A final or empty page has null. Retention may expire records between pages; pagination does not create a stored snapshot."
}
