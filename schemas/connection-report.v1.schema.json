{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "companion_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "collection_status": {
      "enum": [
        "ok",
        "unavailable"
      ]
    },
    "connections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "server_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "status": {
            "enum": [
              "connected",
              "configured",
              "connecting",
              "not_connected",
              "needs_auth",
              "error",
              "disabled",
              "unknown"
            ]
          }
        },
        "required": [
          "server_name",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "base_revision",
    "companion_version",
    "collection_status",
    "connections"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "collection_status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "connections": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "The executable validator also requires unique server_name values."
}
