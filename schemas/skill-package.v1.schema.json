{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyasukun/myhermes-starter/schemas/skill-package.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "description",
    "files",
    "requires"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content_base64",
          "sha256",
          "executable"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 699052,
            "contentEncoding": "base64"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectors",
        "connections"
      ],
      "properties": {
        "connectors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connector_id",
              "version"
            ],
            "properties": {
              "connector_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "skill_id",
        "version",
        "sha256"
      ],
      "properties": {
        "scope": {
          "enum": [
            "company",
            "personal"
          ]
        },
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$comment": "Runtime additionally verifies canonical base64, decoded per-file/total byte limits, SHA-256, path sorting/case/ancestor collisions and portable reserved names, exactly root SKILL.md with strict safe two-field frontmatter without embedded bare CR/NEL/LS/PS YAML line breaks or plain space/TAB comments, no NUL/unpaired Unicode, and distinct connector IDs."
}
