{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyasukun/myhermes-starter/schemas/sync-update.v1.schema.json",
  "title": "MyHermes sync update v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "update_id", "base_revision", "changes"],
  "properties": {
    "schema_version": {"const": "1"},
    "update_id": {"type": "string", "format": "uuid"},
    "base_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "resolves_update_id": {"type": "string", "format": "uuid"},
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": {"path": {"const": "SOUL.md"}, "content": {"type": ["string", "null"], "maxLength": 65536}}},
          {"type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": {"path": {"const": "memories/MEMORY.md"}, "content": {"type": ["string", "null"], "maxLength": 2200}}},
          {"type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": {"path": {"const": "memories/USER.md"}, "content": {"type": ["string", "null"], "maxLength": 1375}}}
        ]
      },
      "$comment": "Runtime additionally rejects repeated paths, NUL and unpaired Unicode surrogates."
    }
  }
}
