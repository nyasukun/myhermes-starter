{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myhermes.example/schemas/credential-binding.v1.schema.json",
  "title": "credential-binding version 1",
  "$comment": "Public runtime additionally enforces cross-field capability consistency, case-insensitive resource uniqueness, grant subset and ready-binding verification rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "grant_revision",
    "status",
    "verified_account_id",
    "requested_permissions",
    "tested_capabilities",
    "tested_resources",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "grant_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "ready",
        "needs_auth",
        "error"
      ]
    },
    "verified_account_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "requested_permissions": {
      "type": "array",
      "items": {
        "enum": [
          "metadata:read",
          "issues:read"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "tested_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "repository.read",
          "issues.read"
        ]
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "tested_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "owner",
          "repository"
        ],
        "properties": {
          "kind": {
            "const": "github_repository"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        }
      },
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true
    },
    "error_code": {
      "enum": [
        null,
        "auth_rejected",
        "resource_forbidden",
        "network_error",
        "account_mismatch",
        "credential_unavailable"
      ]
    }
  }
}
