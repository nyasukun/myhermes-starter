{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The executable contract additionally limits compact UTF-8 integration JSON to 16000 bytes, rejects control characters, and parses the HTTPS guide URL to reject credentials, query and fragment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "integration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "required": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mcp"
            },
            "server_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "server_name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "github"
            },
            "template_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            }
          },
          "required": [
            "kind",
            "template_id"
          ]
        }
      ]
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri",
              "pattern": "^https://[^\\s\\\\?#@]+$"
            }
          ]
        }
      },
      "required": [
        "summary",
        "steps",
        "url"
      ]
    }
  },
  "required": [
    "integration_id",
    "display_name",
    "service",
    "required",
    "enabled",
    "source",
    "guide"
  ]
}
