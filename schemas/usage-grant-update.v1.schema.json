{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myhermes.example/schemas/usage-grant-update.v1.schema.json",
  "title": "usage-grant-update version 1",
  "$comment": "Public runtime additionally enforces cross-field capability consistency, case-insensitive resource uniqueness, grant subset and ready-binding verification rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "base_revision",
    "notice_version",
    "accepted",
    "operations",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "notice_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "accepted": {
      "const": true
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "repository.read",
          "issues.read"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "owner",
          "repository"
        ],
        "properties": {
          "kind": {
            "const": "github_repository"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true
    }
  }
}
