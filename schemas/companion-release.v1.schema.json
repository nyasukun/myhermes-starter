{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "wheel_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://github\\.com/nyasukun/myhermes-starter/releases/download/v[0-9.]+/myhermes_companion-[0-9.]+-py3-none-any\\.whl$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "wheel_url",
    "sha256"
  ],
  "description": "The executable validator additionally requires both URL versions to exactly equal version."
}
